                        @if($log['error']) <div style="color:var(--danger);font-size:10px">❌ {{ $log['error'] }}</div> @endif
                    </div>
                @empty
                    <p style="text-align:center;padding:20px;opacity:.5">لاگی نیست</p>
                @endforelse
            </div>
        </div>
    @endif
</div>
