<?php

namespace App\Livewire;

use App\Models\Channel;
use App\Models\Customer;
use App\Models\Order;
use Illuminate\Support\Facades\DB;
use Livewire\Component;

class Dashboard extends Component
{
    public string $range = 'today';

    public function setRange(string $r): void
    {
        $this->range = $r;
    }

    protected function periodBounds(): array
    {
        return match ($this->range) {
            'today'    => [now()->startOfDay(), now()->endOfDay(), now()->subDay()->startOfDay(), now()->subDay()->endOfDay()],
            'yesterday'=> [now()->subDay()->startOfDay(), now()->subDay()->endOfDay(), now()->subDays(2)->startOfDay(), now()->subDays(2)->endOfDay()],
            '7days'    => [now()->subDays(6)->startOfDay(), now()->endOfDay(), now()->subDays(13)->startOfDay(), now()->subDays(7)->endOfDay()],
            '30days'   => [now()->subDays(29)->startOfDay(), now()->endOfDay(), now()->subDays(59)->startOfDay(), now()->subDays(30)->endOfDay()],
            'month'    => [now()->startOfMonth(), now()->endOfMonth(), now()->subMonth()->startOfMonth(), now()->subMonth()->endOfMonth()],
            default    => [now()->startOfDay(), now()->endOfDay(), now()->subDay()->startOfDay(), now()->subDay()->endOfDay()],
        };
    }

    protected function growth(float $current, float $prev): array
    {
        if ($prev == 0) {
            return $current > 0 ? ['dir' => 'up', 'pct' => 100, 'text' => '+100%'] : ['dir' => 'flat', 'pct' => 0, 'text' => '0%'];
        }
        $pct = round((($current - $prev) / $prev) * 100, 1);
        if ($pct > 0)  return ['dir' => 'up',   'pct' => $pct, 'text' => '+' . $pct . '%'];
        if ($pct < 0)  return ['dir' => 'down', 'pct' => abs($pct), 'text' => '−' . abs($pct) . '%'];
        return ['dir' => 'flat', 'pct' => 0, 'text' => '0%'];
    }

    public function render()
    {
        [$from, $to, $pFrom, $pTo] = $this->periodBounds();

        // KPI 1 — سفارش
        $ordersCur  = Order::whereBetween('created_at', [$from, $to])->count();
        $ordersPrev = Order::whereBetween('created_at', [$pFrom, $pTo])->count();

        // KPI 2 — فروش
        $salesCur  = (float) Order::whereBetween('created_at', [$from, $to])->sum('amount');
        $salesPrev = (float) Order::whereBetween('created_at', [$pFrom, $pTo])->sum('amount');

        // KPI 3 — مشتری
        $custCur  = Customer::whereBetween('created_at', [$from, $to])->count();
        $custPrev = Customer::whereBetween('created_at', [$pFrom, $pTo])->count();
        $custTotal = Customer::count();

        // KPI 4 — شناسنامه
        $certCur  = \App\Models\Certificate::whereBetween('created_at', [$from, $to])->count();
        $certPrev = \App\Models\Certificate::whereBetween('created_at', [$pFrom, $pTo])->count();
        $certTotal = \App\Models\Certificate::count();

        // KPI 5 — وضعیت سفارش
        $statusBreakdown = Order::query()
            ->select('status', DB::raw('COUNT(*) as c'))
            ->whereBetween('created_at', [$from, $to])
            ->groupBy('status')
            ->pluck('c', 'status')
            ->toArray();

        // KPI 6 — میانگین سفارش
        $avgCur  = $ordersCur  > 0 ? $salesCur  / $ordersCur  : 0;
        $avgPrev = $ordersPrev > 0 ? $salesPrev / $ordersPrev : 0;

        $kpis = [
            [
                'key' => 'orders',
                'title' => 'سفارش',
                'value' => number_format($ordersCur),
                'raw' => $ordersCur,
                'unit' => 'سفارش',
                'icon' => '📦',
                'iconClass' => 'ic-sky',
                'comparison_label' => 'قبلی',
                'previous' => number_format($ordersPrev),
                'growth' => $this->growth($ordersCur, $ordersPrev),
                'meta' => [
                    'جدید'    => $statusBreakdown['pending'] ?? 0,
                    'چک'      => $statusBreakdown['final-check'] ?? 0,
                    'ارسال'   => $statusBreakdown['courier'] ?? 0,
                ],
            ],
            [
                'key' => 'sales',
                'title' => 'فروش',
                'value' => number_format($salesCur),
                'raw' => $salesCur,
                'unit' => 'تومان',
                'icon' => '💰',
                'iconClass' => 'ic-green',
                'comparison_label' => 'قبلی',
                'previous' => number_format($salesPrev),
                'growth' => $this->growth($salesCur, $salesPrev),
                'meta' => [
                    'سفارش' => $ordersCur,
                    'میانگین' => number_format((int) $avgCur),
                ],
            ],
            [
                'key' => 'customers',
                'title' => 'مشتری',
                'value' => number_format($custCur),
                'raw' => $custCur,
                'unit' => 'نفر',
                'icon' => '👥',
                'iconClass' => 'ic-indigo',
                'comparison_label' => 'قبلی',
                'previous' => number_format($custPrev),
                'growth' => $this->growth($custCur, $custPrev),
                'meta' => [
                    'کل' => number_format($custTotal),
                ],
            ],
            [
                'key' => 'certificates',
                'title' => 'شناسنامه',
                'value' => number_format($certCur),
                'raw' => $certCur,
                'unit' => 'کارت',
                'icon' => '💎',
                'iconClass' => 'ic-violet',
                'comparison_label' => 'قبلی',
                'previous' => number_format($certPrev),
                'growth' => $this->growth($certCur, $certPrev),
                'meta' => [
                    'کل' => number_format($certTotal),
                ],
            ],
            [
                'key' => 'avg_order',
                'title' => 'میانگین سفارش',
                'value' => number_format((int) $avgCur),
                'raw' => $avgCur,
                'unit' => 'تومان',
                'icon' => '📊',
                'iconClass' => 'ic-amber',
                'comparison_label' => 'قبلی',
                'previous' => number_format((int) $avgPrev),
                'growth' => $this->growth($avgCur, $avgPrev),
                'meta' => [],
            ],
        ];

        // آخرین سفارشات
        $recentOrders = Order::with(['customer', 'channel'])
            ->latest('id')->limit(5)->get();

        // پرفروش‌ها (برای الان بر اساس تعداد سفارش در کانال)
        $topProducts = DB::table('order_items')
            ->select('title', DB::raw('COUNT(*) as c'), DB::raw('SUM(price * quantity) as total'))
            ->groupBy('title')
            ->orderByDesc('c')
            ->limit(5)
            ->get();

        // کانال‌ها
        $channels = Channel::where('is_active', true)
            ->withCount(['orders' => fn ($q) => $q->whereBetween('created_at', [$from, $to])])
            ->orderByDesc('orders_count')
            ->limit(5)
            ->get();

        // وضعیت ارسال
        $statusCounts = [
            'pending'     => $statusBreakdown['pending'] ?? 0,
            'final-check' => $statusBreakdown['final-check'] ?? 0,
            'courier'     => $statusBreakdown['courier'] ?? 0,
        ];

        return view('livewire.dashboard', compact(
            'kpis', 'recentOrders', 'topProducts', 'channels', 'statusCounts'
        ))->layout('components.layouts.app');
    }
}
