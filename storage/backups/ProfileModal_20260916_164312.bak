<?php

namespace App\Livewire\Customers;

use App\Models\Customer;
use App\Models\Order;
use Livewire\Component;

class ProfileModal extends Component
{
    public bool $show = false;
    public ?string $phone = null;
    public ?Customer $customer = null;
    public array $orders = [];

    protected $listeners = ['show-customer-profile' => 'open'];

    public function open(string $phone): void
    {
        $this->phone = $phone;
        $normalized = preg_replace('/\D/', '', $phone);
        if (str_starts_with($normalized, '98') && strlen($normalized) > 10) $normalized = substr($normalized, 2);
        if (str_starts_with($normalized, '0') && strlen($normalized) > 10) $normalized = substr($normalized, 1);

        $this->customer = Customer::where('phone', 'like', "%{$normalized}%")->first();

        $this->orders = Order::where('phone', 'like', "%{$normalized}%")
            ->with('channel')
            ->latest('id')
            ->limit(20)
            ->get()
            ->all();

        $this->show = true;
    }

    public function close(): void
    {
        $this->show = false;
        $this->customer = null;
        $this->orders = [];
    }

    public function render()
    {
        return view('livewire.customers.profile-modal');
    }
}
