<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
const certShowHtml = @json($html);

function mountCertShow() {
    const mount = document.getElementById('certShowMount');
    if (!mount) return;
    mount.innerHTML = '';
    const iframe = document.createElement('iframe');
    iframe.id = 'certShowFrame';
    iframe.style.cssText = 'width: 100%; height: 100%; border: 0; background: #fffef9;';
    iframe.setAttribute('sandbox', 'allow-same-origin');
    iframe.srcdoc = certShowHtml;
    mount.appendChild(iframe);
}

document.addEventListener('DOMContentLoaded', () => setTimeout(mountCertShow, 100));

function getShowCertEl() {
    const frame = document.getElementById('certShowFrame');
    if (!frame) return null;
    const doc = frame.contentDocument || frame.contentWindow.document;
    return doc.querySelector('.cert');
}

function printCurrentCert() {
    const frame = document.getElementById('certShowFrame');
    if (!frame) { alert('کارت پیدا نشد'); return; }
    const w = window.open('', '', 'width=900,height=900');
    w.document.write(frame.srcdoc);
    w.document.close();
    setTimeout(() => { w.print(); setTimeout(() => w.close(), 500); }, 600);
}

async function exportCurrentCertPng() {
    const cert = getShowCertEl();
    if (!cert) { alert('کارت پیدا نشد'); return; }
    try {
        if (typeof safeHtml2Canvas !== 'function') {
            alert('کتابخانه آماده نیست');
            return;
        }
        const canvas = await safeHtml2Canvas(cert, { scale: 3, backgroundColor: '#fffef9' });
        const a = document.createElement('a');
        a.download = 'certificate-{{ $certificate->code }}.png';
        a.href = canvas.toDataURL('image/png');
        a.click();
    } catch (e) {
        console.error(e);
        alert('خطا در ساخت PNG');
    }
}
</script>
