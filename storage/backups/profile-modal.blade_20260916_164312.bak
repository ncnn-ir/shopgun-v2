                </div>
                <button wire:click="close" class="btn btn-ghost btn-sm btn-circle">✕</button>
            </div>

            <div class="p-5 space-y-4 max-h-[calc(100vh-14rem)] overflow-y-auto">

                <div class="grid grid-cols-3 gap-2">
