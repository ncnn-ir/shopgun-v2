def main():
    banner("ShopGun V2 — Timeline + Accounting")

    if not (ROOT / "artisan").exists():
        err("artisan نیست."); return

    # 1) Migrations
    step(1, "Migrations")
    write(f"database/migrations/{MIG}_create_order_timeline_events.php", MIG_TIMELINE)
    write(f"database/migrations/{MIG}_create_accounting_tables.php", MIG_ACC)

    # 2) Models
    step(2, "Models")
    write("app/Models/OrderTimelineEvent.php", MODEL_TLE)
    write("app/Models/AccountingParty.php", MODEL_PARTY)
    write("app/Models/AccountingTransaction.php", MODEL_TXN)
    write("app/Models/AccountingSmsInbox.php", MODEL_SMS)

    # 3) Trait update
    step(3, "به‌روزرسانی HasSupplyTracking با متدهای timeline")
    tp = ROOT / "app" / "Models" / "Concerns" / "HasSupplyTracking.php"
    if tp.exists():
        txt = tp.read_text(encoding="utf-8")
        if "timelineEvents" not in txt:
            last = txt.rfind("}")
            if last != -1:
                backup(tp)
                txt = txt[:last] + TRAIT_ADD + "\n}\n"
                tp.write_text(txt, encoding="utf-8")
                ok("HasSupplyTracking به‌روزرسانی شد")
        else:
            ok("قبلاً به‌روز است")

    # 4) SMS Parser
    step(4, "SmsParser Service")
    write("app/Application/Accounting/SmsParser.php", SMS_PARSER)

    # 5) Livewire: StatusChanger
    step(5, "Livewire StatusChanger")
    write("app/Livewire/Orders/StatusChanger.php", LW_STATUS)
    write("resources/views/livewire/orders/status-changer.blade.php", BLADE_STATUS)

    # 6) Livewire: Accounting Index
    step(6, "Livewire Accounting Index")
    write("app/Livewire/Accounting/Index.php", LW_ACC)
    write("resources/views/livewire/accounting/index.blade.php", BLADE_ACC)

    # 7) CSS
    step(7, "افزودن CSS")
    css = ROOT / "public" / "css" / "shopgun-channels.css"
    if css.exists():
        txt = css.read_text(encoding="utf-8")
        if "Accounting KPI Cards" not in txt:
            backup(css)
            css.write_text(txt + "\n\n" + CSS_ACC, encoding="utf-8")
            ok("CSS اضافه شد")
    else:
        write("public/css/shopgun-channels.css", CSS_ACC)

    # 8) Routes
    step(8, "افزودن routes")
    rp = ROOT / "routes" / "web.php"
    if rp.exists():
        txt = rp.read_text(encoding="utf-8")
        inject = ""
        if "accounting" not in txt:
            inject += """

// ═══ Accounting (auto) ═══
use App\\Livewire\\Accounting\\Index as AccountingIndex;
Route::middleware(['auth'])->group(function () {
    Route::get('/accounting', AccountingIndex::class)->name('accounting.index');
});
// ═════════════════════════
"""
        if inject:
            backup(rp)
            rp.write_text(txt + inject, encoding="utf-8")
            ok("routes اضافه شد")

    # 9) افزودن StatusChanger به layout
    step(9, "افزودن StatusChanger به layout")
    lo = ROOT / "resources" / "views" / "components" / "layouts" / "app.blade.php"
    if lo.exists():
        txt = lo.read_text(encoding="utf-8")
        if "orders.status-changer" not in txt:
            marker = "<livewire:orders.supply-modal"
            if marker in txt:
                m = re.search(r"<livewire:orders\.supply-modal[^>]*/>", txt)
                if m:
                    backup(lo)
                    txt = txt[:m.end()] + '\n    <livewire:orders.status-changer :key="\'osc\'" />' + txt[m.end():]
                    lo.write_text(txt, encoding="utf-8")
                    ok("StatusChanger به layout اضافه شد")
            elif "@endauth" in txt:
                backup(lo)
                txt = txt.replace("@endauth",
                    '    <livewire:orders.status-changer :key="\'osc\'" />\n@endauth', 1)
                lo.write_text(txt, encoding="utf-8")
                ok("StatusChanger به layout اضافه شد")

    # 10) افزودن لینک حسابداری به sidebar
    step(10, "افزودن لینک حسابداری به sidebar")
    sb = ROOT / "resources" / "views" / "livewire" / "components" / "sidebar.blade.php"
    if sb.exists():
        txt = sb.read_text(encoding="utf-8")
        if "accounting.index" not in txt:
            # اضافه به menu array
            if "['route' => 'activity-log'" in txt:
                backup(sb)
                txt = txt.replace(
                    "['route' => 'activity-log',       'icon' => '📜', 'label' => 'لاگ'],",
                    "['route' => 'accounting.index',   'icon' => '💰', 'label' => 'حسابداری'],\n                    ['route' => 'activity-log',       'icon' => '📜', 'label' => 'لاگ'],",
                    1
                )
                sb.write_text(txt, encoding="utf-8")
                ok("لینک اضافه شد")

    # 11) Migration + Clear
    step(11, "اجرای migration")
    run("php artisan migrate --force")
    step(12, "پاک‌سازی")
    run("php artisan optimize:clear")

    banner("✅ کامل شد")
