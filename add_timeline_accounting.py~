# -*- coding: utf-8 -*-
"""
ShopGun V2 — Timeline Statuses + Accounting Module
"""
import re, shutil, subprocess
from pathlib import Path
from datetime import datetime

ROOT = Path(__file__).resolve().parent
TS = datetime.now().strftime("%Y%m%d_%H%M%S")
MIG = datetime.now().strftime("%Y_%m_%d_%H%M%S")

class C:
    R="\033[0m"; B="\033[1m"; RED="\033[91m"; GRN="\033[92m"; YEL="\033[93m"
    CYN="\033[96m"; GRAY="\033[90m"
def ok(m):   print(f"  {C.GRN}✓{C.R} {m}")
def warn(m): print(f"  {C.YEL}⚠{C.R} {m}")
def err(m):  print(f"  {C.RED}✗{C.R} {m}")
def info(m): print(f"  {C.GRAY}ℹ{C.R} {m}")
def step(n,m): print(f"\n{C.YEL}{C.B}[{n}]{C.R} {m}")
def banner(m):
    print(f"\n{C.CYN}{'═'*66}{C.R}")
    print(f"{C.B}  {m}{C.R}")
    print(f"{C.CYN}{'═'*66}{C.R}")

def backup(p):
    if p.exists(): shutil.copy2(p, p.with_name(p.name + f".bak.{TS}"))

def write(rel, txt):
    p = ROOT / rel
    if p.exists(): backup(p); warn(f"پشتیبان: {p.name}.bak.{TS}")
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(txt, encoding="utf-8"); ok(rel)

def run(cmd, silent=False):
    if not silent: print(f"  {C.CYN}${C.R} {cmd}")
    r = subprocess.run(cmd, shell=True, cwd=str(ROOT),
                       capture_output=True, text=True, encoding="utf-8", errors="replace")
    if r.stdout.strip() and not silent:
        print(f"  {C.GRAY}{r.stdout.strip()[:800]}{C.R}")
    if r.returncode != 0 and r.stderr.strip():
        print(f"  {C.RED}{r.stderr.strip()[:800]}{C.R}")
    return r.returncode == 0


