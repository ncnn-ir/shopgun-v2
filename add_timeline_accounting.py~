                    'events' => [['at' => $ev->occurred_at, 'notes' => $ev->notes, 'user' => $ev->user?->name]],
                ];
            }
        }

        usort($stages, fn($a, $b) => ($a['at']?->timestamp ?? PHP_INT_MAX) <=> ($b['at']?->timestamp ?? PHP_INT_MAX));
        return $stages;
    }
