    /**
     * رویدادهای پیکربندی‌شده — همیشه نمایش داده می‌شن
     */
    public static function timelineStages(): array
    {
        return [
            'created'               => 'ثبت سفارش',
            'paid'                  => 'پرداخت',
            'sent_for_sizing'       => 'ارسال برای سایز',
            'sent_for_making'       => 'ارسال برای ساخت',
            'supply_found'          => 'محصول پیدا شد',
            'delivered_to_shipping' => 'تحویل واحد ارسال',
            'packaging'             => 'بسته بندی',
            'final_check'           => 'چک نهایی',
            'handed_to_courier'     => 'تحویل پیک',
            'registered_in_system'  => 'ثبت در سامانه ارسال',
            'shipped'               => 'ارسال',
            'delivered'             => 'تحویل به مشتری',
        ];
    }

    /**
     * تایم‌لاین کامل با تمام مراحل + رویدادهای واقعی از DB
     */
    public function fullTimeline(): array
    {
        $events = $this->timelineEvents()->get()->groupBy('event_key');
        $stages = [];

        foreach (self::timelineStages() as $key => $label) {
            [$title, $icon] = \App\Models\OrderTimelineEvent::meta($key);
            $evList = $events->get($key, collect());
            $latest = $evList->first();

            $stages[] = [
                'key'         => $key,
                'title'       => $title,
                'icon'        => $icon,
                'done'        => $evList->count() > 0,
                'at'          => $latest?->occurred_at,
                'user'        => $latest?->user?->name,
                'notes'       => $latest?->notes,
                'events'      => $evList->map(fn($e) => [
                    'at'    => $e->occurred_at,
                    'notes' => $e->notes,
                    'user'  => $e->user?->name,
                ])->all(),
            ];
        }

        // رویدادهای خارج از کاتالوگ استاندارد
        $customKeys = $events->keys()->diff(array_keys(self::timelineStages()));
        foreach ($customKeys as $ck) {
            foreach ($events->get($ck) as $ev) {
