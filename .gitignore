# ─── Laravel defaults ───
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.idea
/.vscode
/.fleet
.DS_Store
Thumbs.db

# ─── Dev artifacts (اسکریپت‌های قدیمی) ───
*.py
hotfix*.py
phase*.py
fix_*.py
part*.py
core_refactor_phase*.py
backups/
*.bak-*
*.bak
*.disabled-*
*.disabled

# ─── فایل‌های ناسازگار با ویندوز (NTFS) ───
# (از قبل در گیت commit شده‌اند، فقط برای جلوگیری از ساخت مجدد)
input:focus,
select:focus,
textarea:focus
